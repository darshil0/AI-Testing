# ==============================================================================
# AI-Testing Environment Configuration
# Instructions: Copy this file to '.env' and add your private keys.
# WARNING: Never commit the actual '.env' file to version control (Git).
# ==============================================================================

# --- Provider API Keys ---
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here

# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Obtain from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_key_here

# --- Logging & Debugging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
